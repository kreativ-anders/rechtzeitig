{
  "name": "rechtzeitig",
  "version": "0.6.0",
  "private": true,
  "description": "GitHub Action that checks a website and its repository for German legal basics (GDPR, DDG, TDDDG), security and an SBOM.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "scan": "node src/main.ts",
    "test": "node --test \"checks/**/test.ts\" \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "benchmark": "node test/benchmark/run.ts",
    "typecheck": "tsc",
    "docs": "node src/docs.ts",
    "drift": "node src/drift.ts",
    "mutate": "node dev/mutate.ts"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
