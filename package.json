{
  "name": "rechtzeitig",
  "version": "0.1.0",
  "private": true,
  "description": "Checks a website for German/EU legal basics (GDPR, DDG, TDDDG) from a manually started GitHub workflow.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "scan": "node src/main.ts",
    "test": "node --test \"checks/**/test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "docs": "node src/docs.ts"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
